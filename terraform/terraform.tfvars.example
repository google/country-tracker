# ==============================================================================
# Country Tracker Terraform Environment Variables Override Template
# ------------------------------------------------------------------------------
# Usage:
# 1. Copy this file: `cp terraform.tfvars.example terraform.tfvars`
# 2. Modify the placeholder values below with your specific GCP configuration.
# 3. Securely deploy using `terraform apply`.
# ==============================================================================

# The true GCP Universal Project Slug
project_id = "your-gcp-project-id"

# Google Cloud physical deployment region
region = "us-central1"

# The literal matching target in GitHub (Crucial for IAM restriction rules security mask)
github_repository = "your-github-username/country-tracker"

# Optional: Set this to map a custom domain directly to the Cloud Run service. 
# Once applied, point your DNS CNAME record to ghs.googlehosted.com.
custom_domain = "app.country-tracker.com"


